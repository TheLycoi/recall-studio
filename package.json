{
  "name": "obsidian-wikilm",
  "version": "0.13.0",
  "description": "Highlight-centric flashcard pipeline for Obsidian: highlight, write cards in the background, triage in an inbox, export to Anki.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node scripts/vendor-types-guard.mjs && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "vendor:types": "node scripts/vendor-types.mjs",
    "vendor:check": "node scripts/vendor-check.mjs",
    "vendor:manifest": "node scripts/vendor-manifest.mjs",
    "vendor:update": "node scripts/vendor-update.mjs",
    "install:vault": "npm run build && node scripts/install.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.98",
    "@ai-sdk/openai": "3.0.86",
    "@ai-sdk/openai-compatible": "2.0.62",
    "@anthropic-ai/sdk": "^0.124.0",
    "ai": "6.0.230",
    "fflate": "0.8.3",
    "zod": "^4.5.4"
  }
}
